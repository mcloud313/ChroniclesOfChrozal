# Generate a unique password. This file contains examples only.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://chrozal:replace-with-a-long-random-password@db:5432/chrozaldb
PUBLIC_ORIGIN=http://localhost:8000
HOST=0.0.0.0
PORT=8000
MAX_PLAYERS=100
DB_POOL_SIZE=10
ALLOW_REGISTRATION=false
DOMAIN=chrozal.example.com

# Public signup and password recovery require a STARTTLS SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
